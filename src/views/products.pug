doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet" , href="/styles/globals.css")
        title products page
    body 

        h1= pageTitle
        p= description
        //- product list
    .main-container
        .products-grid
            each product in products 
                .product-card
                    .item-container
                        a(href=`/products/${product.id}`) 
                            h2.item-heading= product.title 
                        p.item-description= product.description 
                        p.item-price= product.price
                        button.item-cart-btn Add To Cart