doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title products page
    body 

        h1= pageTitle
        p= description
        //- product list
        div
            each product in products 
                li
                    .item-container
                        h2.item-heading= product.title 
                        p.item-description= product.description 
                        p.item-price= product.price
                        button.item-cart-btn Add To Cart